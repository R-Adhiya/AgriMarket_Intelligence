# ─── AgriMarket Intelligence — Environment Configuration ───────────────────
# Copy this file to .env and fill in real values.
# Never commit .env — it is in .gitignore.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/agrimarket
# For local development without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite:///./agrimarket_dev.db

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# Single frontend origin (also added to CORS_ORIGINS automatically)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins (optional, FRONTEND_URL is always included)
CORS_ORIGINS=http://localhost:5173

# ── Admin seed (development only) ─────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Transport cost estimation ─────────────────────────────────────────────────
TRANSPORT_BASE_COST=200.0
TRANSPORT_RATE_PER_KM=2.5
TRANSPORT_QUANTITY_UNIT=quintal
